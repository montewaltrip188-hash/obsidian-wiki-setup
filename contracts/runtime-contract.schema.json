{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://junyong.ai/contracts/runtime-contract.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_format", "product_id", "schema_version", "runtime"],
  "properties": {
    "contract_format": {"const": 1},
    "product_id": {"type": "string", "minLength": 1},
    "schema_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "required_range", "tested", "required_entries"],
      "properties": {
        "id": {"const": "claudecode-wiki-skills"},
        "required_range": {"type": "string", "minLength": 1},
        "tested": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "commit"],
          "properties": {
            "version": {"type": "string"},
            "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            "release_tag": {"type": "string"},
            "release_tag_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
          }
        },
        "required_entries": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string"}
        }
      }
    }
  }
}
