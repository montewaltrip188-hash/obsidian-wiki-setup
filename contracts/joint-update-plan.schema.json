{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://junyong.ai/contracts/joint-update-plan.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["command", "home", "include_ima", "index_plan", "plan_id", "skill_plan", "status", "strict_query", "vault", "vault_plan"],
  "properties": {
    "command": {"const": "joint-plan"},
    "home": {"type": "string", "minLength": 1},
    "include_ima": {"type": "boolean"},
    "index_plan": {
      "type": "object",
      "required": ["action", "status", "index_action", "target_fingerprint"],
      "properties": {
        "action": {"const": "index-status"},
        "status": {"const": "completed"},
        "index_action": {"enum": ["none", "full_rebuild"]},
        "target_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "plan_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "skill_plan": {"type": "object"},
    "status": {"enum": ["approval_required", "up_to_date", "legacy_adoption_required", "blocked"]},
    "strict_query": {
      "type": "object",
      "additionalProperties": false,
      "required": ["query", "expect_path", "expect_content_sha256"],
      "properties": {
        "query": {"type": "string", "minLength": 1},
        "expect_path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+"},
        "expect_content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "vault": {"type": "string", "minLength": 1},
    "vault_plan": {"type": "object"}
  }
}
