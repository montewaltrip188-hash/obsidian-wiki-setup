{
  "schema_version": 2,
  "component": "claudecode-wiki-skills",
  "commands": [
    "plan",
    "install",
    "verify",
    "rollback",
    "uninstall",
    "undo",
    "undo-check"
  ],
  "defaults": {
    "scope": "user",
    "skills": [
      "design-juan-wiki",
      "wiki-hybrid-search",
      "ocr-and-documents"
    ],
    "ima_skill": "explicit_opt_in",
    "offline_baseline": "keyword",
    "keyword_runtime_ready": true,
    "keyword_runtime_status": "ready",
    "keyword_runtime_error": null,
    "keyword_runtime_id": "cpython-3.12.14+20260825",
    "keyword_runtime_targets": [
      "windows-x64",
      "macos-x64",
      "macos-arm64"
    ],
    "vector_capability": "optional",
    "link_mode": "auto",
    "copy_fallback": "explicit_opt_in"
  },
  "layout": {
    "package_versions": "~/.agents/packages/claudecode-wiki-skills/versions/<version>",
    "codex_entries": "~/.agents/skills/<skill>",
    "claude_entries": "~/.claude/skills/<skill>"
  },
  "plan": {
    "strictly_read_only": true,
    "actions": [
      "install",
      "upgrade",
      "already_installed"
    ],
    "precedes_vault_write": true
  },
  "undo": {
    "receipt_source": "install_output.undo_receipt",
    "bindings": [
      "transaction_id",
      "home",
      "changed",
      "before",
      "after",
      "package_fingerprint",
      "entries_fingerprint",
      "generation"
    ],
    "current_state_requirement": "must_equal_receipt_after_state",
    "unchanged_transaction": "no_op",
    "upgrade_restore": "exact_previous_state_and_remove_transaction_version",
    "setup_failure_policy": "verify_or_vault_failure_calls_receipt_bound_undo"
  },
  "transaction_lock": {
    "commands": [
      "install",
      "rollback",
      "uninstall",
      "undo"
    ],
    "read_only_commands": [
      "plan",
      "verify",
      "undo-check"
    ],
    "lease": "kernel_file_lock",
    "metadata": [
      "owner_id",
      "pid",
      "hostname",
      "operation",
      "home",
      "created_at",
      "released_at"
    ],
    "stale_recovery": "automatic_on_process_exit",
    "active_lock_policy": "never_break_by_timeout",
    "release_audit_failure": "best_effort_result_warning",
    "corrupt_stale_audit_recovery": "overwrite_only_after_kernel_lock_acquired"
  },
  "ownership": {
    "state": "~/.agents/packages/claudecode-wiki-skills/state.json",
    "state_schema_version": 2,
    "install_generation": "persistent_transaction_id",
    "legacy_schema_v1": "read_only_compatible_with_optional_valid_generation",
    "legacy_migration": "first_locked_install_transaction",
    "version_manifest": ".wiki-skill-install.json",
    "runtime_aliases": "logical_runtime_to_owned_root",
    "owned_roots": "one_entry_set_per_physical_root",
    "uninstall_policy": "manifest_owned_only"
  },
  "dependency_policy": {
    "automatic_network_install": false,
    "client_package_install": "forbidden",
    "system_python_modification": "forbidden",
    "bom": "contracts/offline-keyword-runtime-bom.json",
    "ready_requires": [
      "isolated_interpreter",
      "locked_dependency_bundle",
      "keyword_query_runtime_test"
    ]
  },
  "fail_closed_on": [
    "unknown_same_name_entry",
    "root_is_not_directory",
    "fingerprint_drift",
    "link_target_drift",
    "runtime_root_alias_drift",
    "version_content_collision",
    "skill_set_change_during_upgrade",
    "link_mode_migration",
    "link_creation_without_copy_authorization",
    "concurrent_mutation",
    "after_state_drift",
    "undo_receipt_mismatch",
    "network_dependency_required",
    "elevation_required"
  ]
}
